  name: cloud-api-capacity
  namespace: cloud-dev-apps
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: cloud-api-capacity
subjects:
- kind: ServiceAccount
  name: cloud-api
  namespace: cloud-dev
---
