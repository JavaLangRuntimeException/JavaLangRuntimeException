apiVersion: v1
kind: ResourceQuota
metadata:
  name: apps
  namespace: cloud-dev-apps
spec:
  hard:
    limits.cpu: "1"
    limits.memory: 512Mi
    persistentvolumeclaims: "3"
    pods: "10"
    requests.cpu: "1"
    requests.memory: 512Mi
    requests.storage: 10Gi
    services.loadbalancers: "0"
    services.nodeports: "0"
---
apiVersion: v1
kind: ResourceQuota
metadata:
  name: require-cloud-priority
  namespace: cloud-dev-apps
spec:
  hard:
    pods: "0"
  scopeSelector:
    matchExpressions:
    - operator: NotIn
      scopeName: PriorityClass
      values:
      - cloud-workload
---
apiVersion: v1
automountServiceAccountToken: false
kind: ServiceAccount
metadata:
  name: default
  namespace: cloud-dev-apps
---
apiVersion: v1
automountServiceAccountToken: false
kind: ServiceAccount
