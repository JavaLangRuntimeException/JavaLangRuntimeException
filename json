apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: cloud-api
  namespace: cloud-dev
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: cloud-api
subjects:
