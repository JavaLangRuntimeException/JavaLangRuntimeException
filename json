apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/name: console
  name: console
  namespace: cloud-dev
spec:
  ports:
  - name: http
    port: 8080
    targetPort: http
  selector:
    app.kubernetes.io/name: console
---
apiVersion: v1
kind: LimitRange
metadata:
  name: apps
  namespace: cloud-dev-apps
spec:
  limits:
  - default:
      cpu: 250m
      memory: 256Mi
    defaultRequest:
      cpu: 50m
      memory: 256Mi
    max:
      cpu: "1"
      memory: 1Gi
    maxLimitRequestRatio:
      memory: "1"
    type: Container
  - max:
      storage: 20Gi
    type: PersistentVolumeClaim
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/name: cloud-api
    app.kubernetes.io/part-of: taramanji-cloud
  name: cloud-api
  namespace: cloud-dev
spec:
  replicas: 1
  revisionHistoryLimit: 5
  selector:
    matchLabels:
      app.kubernetes.io/name: cloud-api
  strategy:
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  template:
    metadata:
      annotations:
        ad.datadoghq.com/app.logs: '[{"source":"go","service":"cloud-api"}]'
      labels:
        app.kubernetes.io/name: cloud-api
        app.kubernetes.io/part-of: taramanji-cloud
        tags.datadoghq.com/env: dev
        tags.datadoghq.com/service: cloud-api
        tags.datadoghq.com/version: unreleased
    spec:
      automountServiceAccountToken: true
      containers:
      - env:
        - name: APP_ENV
          value: dev
        - name: CLOUD_ENV
          value: dev
        - name: APPS_NAMESPACE
          value: cloud-dev-apps
        - name: CONSOLE_ORIGIN
          value: https://cloud-dev.taramanji.com
        - name: HOST_SUFFIX
          value: -cloud-dev.taramanji.com
        - name: PORT
          value: :8080
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: DD_AGENT_HOST
          valueFrom:
            fieldRef:
              fieldPath: status.hostIP
        - name: DD_ENV
          valueFrom:
            fieldRef:
              fieldPath: metadata.labels['tags.datadoghq.com/env']
        - name: DD_SERVICE
          valueFrom:
            fieldRef:
              fieldPath: metadata.labels['tags.datadoghq.com/service']
        - name: DD_VERSION
          valueFrom:
            fieldRef:
              fieldPath: metadata.labels['tags.datadoghq.com/version']
        - name: DD_LOGS_INJECTION
          value: "true"
        - name: DD_TRACE_SPAN_ATTRIBUTE_SCHEMA
          value: v1
        - name: GOMEMLIMIT
          valueFrom:
            resourceFieldRef:
              resource: limits.memory
        - name: FUNCTION_IDLE_TIMEOUT
          value: 5m
        - name: APPS_REPO
          value: JavaLangRuntimeException/taramanji-cloud-apps
        - name: CF_ACCESS_TEAM_DOMAIN
          value: https://solitary-sun-32e2.cloudflareaccess.com
        envFrom:
        - secretRef:
            name: cloud-api-env
        image: ghcr.io/javalangruntimeexception/taramanji-cloud:unreleased
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /healthz
            port: http
          periodSeconds: 10
        name: app
        ports:
        - containerPort: 8080
          name: http
        readinessProbe:
          httpGet:
            path: /readyz
            port: http
          periodSeconds: 5
        resources:
          limits:
            memory: 128Mi
          requests:
            cpu: 10m
            memory: 24Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
        startupProbe:
          failureThreshold: 30
          httpGet:
            path: /readyz
            port: http
          periodSeconds: 2
      enableServiceLinks: false
      securityContext:
        runAsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
      serviceAccountName: cloud-api
      terminationGracePeriodSeconds: 30
---
