<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- sshd のログを Datadog に送る常駐プロセス。install.sh が __HOME__ を置き換えて ~/Library/LaunchAgents に置く -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.taramanji.ssh-logs</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/Library/Application Support/taramanji/ssh-logs/forward.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DD_API_KEY_FILE</key><string>__HOME__/.config/taramanji/datadog-api-key</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/taramanji-ssh-logs.log</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/taramanji-ssh-logs.log</string>
</dict>
</plist>
