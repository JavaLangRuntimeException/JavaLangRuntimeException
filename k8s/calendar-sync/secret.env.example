# kustomize の env ファイルは行末コメント不可。値は = の直後に書く
# --- 管理画面ログイン（NextAuth）とアカウント接続で共通の OAuth クライアント ---
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://gws.taramanji.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 管理画面に入れるメールアドレス（カンマ区切り）
ADMIN_EMAIL=shuta.tanahashi@taramanji.com
# --- 更新トークンの暗号化鍵（openssl rand -base64 32）。変えると全アカウントの再接続が必要 ---
CALENDAR_SYNC_ENC_KEY=
# --- CronJob が /api/calendar-sync を叩くためのトークン（openssl rand -hex 32）---
CALENDAR_SYNC_CRON_TOKEN=
