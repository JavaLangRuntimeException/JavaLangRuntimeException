# kustomize の env ファイルは行末コメント不可。値は = の直後に書く。Vercel の環境変数と同じ値を入れる
# 同じ namespace の Redis を使う。Vercel と同じデータを使うなら本番の REDIS_URL に変える
REDIS_URL=redis://redis:6379
# --- 管理画面ログイン（NextAuth）---
# openssl rand -base64 32
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=
# --- 予約（Google カレンダー）---
GCAL_CALENDAR_ID=
GCAL_SA_JSON_BASE64=
GOOGLE_REFRESH_TOKEN=
GCAL_WEBHOOK_URL=
ICAL_URLS=
ICAL_TZ_OFFSET_MINUTES=
OWNER_EMAIL=
# --- メール送信（Amazon SES）---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FROM_EMAIL=
